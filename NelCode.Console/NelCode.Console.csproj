<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>NelCode</RootNamespace>
    <!-- L'exécutable garde son nom d'avant la séparation : NelCode.exe. -->
    <AssemblyName>NelCode</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.49.1" />
    <ProjectReference Include="..\NelCode.Core\NelCode.Core.csproj" />
  </ItemGroup>

</Project>
